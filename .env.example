# MongoDB Atlas - nunca coloque sua URI real no GitHub
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=login_seguro

# Seed inicial (somente para primeiro acesso; troque antes de publicar)
SEED_ADMIN_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe_123!

# Em HTTPS de produção, use true
SESSION_COOKIE_SECURE=false
PORT=8080